{
  "name": "nexo-social", "version": "1.0.0", "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "dev:api": "npm run dev -w apps/api", "dev:web": "npm run dev -w apps/web",
    "db:generate": "npm run db:generate -w apps/api", "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api", "test": "node --test tests/integration.mjs", "test:migrations":"node tests/migrations.mjs"
  }, "engines": {"node": ">=22"}
}
